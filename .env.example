# Generate these values before deployment: openssl rand -hex 32
PORT=3000
KIE_API_KEY=replace_with_your_kie_key
# Set this to the exact model slug from KIE's current model page.
KIE_MODEL=grok-4-1-fast
KIE_API_BASE=https://api.kie.ai
SESSION_SECRET=replace_with_a_long_random_secret
# First administrator account. It is created only on the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-now
